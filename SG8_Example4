class Student:
    def __init__(self, name, age):
        self.name = name
        self.__age = age

    def get_age(self):
        return self.__age

    def set_age(self, age):
        if age > 0:
            self.__age = age
        else:
            print("Invalid age!")

student1 = Student("Juan", 16)
print(student1.get_age())

student1.set_age(-10)
print(student1.get_age())

student1.set_age(17)
print(student1.get_age())

